include_guard(GLOBAL)
include(FetchContent)

set(OPENRHI_SLANG_VERSION "2026.20")
set(OPENRHI_SLANG_ROOT "" CACHE PATH "Slang 2026.20 host distribution")
set(OPENRHI_SLANG_DXIL_ROOT "" CACHE PATH "Pinned DXIL downstream library distribution")

function(openrhi_require_slang)
    if(TARGET OpenRHI::slangc)
        return()
    endif()
    string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" processor)
    if(processor MATCHES "arm64|aarch64")
        set(arch aarch64)
    else()
        set(arch x86_64)
    endif()
    if(CMAKE_HOST_WIN32)
        set(host windows)
        set(extension zip)
        set(hash_x86_64 e6dd32bbddf1720ebb4e679d55e9635ce792865a5bd84f3d2cd9af28647c0174)
        set(hash_aarch64 4f18a7e76a59969bc9bf6ea596bd9e496a3c689af173990ae028b18f03e1ac1a)
    elseif(CMAKE_HOST_APPLE)
        set(host macos)
        set(extension tar.gz)
        set(hash_x86_64 b4f01f615dc625f60c593d7d0a4bbd38e05dfa2a34bfd3973017c309d866feaa)
        set(hash_aarch64 07fa8833fdbb343c3674c84fdd885910f495f3daaaa0c732b32980151e8b58c4)
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(host linux)
        set(extension tar.gz)
        set(hash_x86_64 e863e568c204810d6e8bc31852f056aef6763c55ea9925db2db7affa060347c9)
        set(hash_aarch64 b0345743e2153d8c2bd33f56fb5696bcef63fc03513f054a1ae1b8d3dd0152a9)
    else()
        message(FATAL_ERROR "Unsupported Slang compiler host: ${CMAKE_HOST_SYSTEM_NAME}")
    endif()
    if(OPENRHI_SLANG_ROOT)
        set(root "${OPENRHI_SLANG_ROOT}")
    else()
        FetchContent_Declare(openrhi_slang
            URL "https://github.com/shader-slang/slang/releases/download/v${OPENRHI_SLANG_VERSION}/slang-${OPENRHI_SLANG_VERSION}-${host}-${arch}.${extension}"
            URL_HASH SHA256=${hash_${arch}}
            DOWNLOAD_EXTRACT_TIMESTAMP TRUE SOURCE_SUBDIR unused)
        FetchContent_MakeAvailable(openrhi_slang)
        set(root "${openrhi_slang_SOURCE_DIR}")
    endif()
    find_program(compiler NAMES slangc HINTS "${root}/bin" NO_DEFAULT_PATH REQUIRED NO_CACHE)
    execute_process(COMMAND "${compiler}" -version OUTPUT_VARIABLE version ERROR_VARIABLE version_error RESULT_VARIABLE result)
    string(STRIP "${version}${version_error}" version)
    if(NOT result EQUAL 0 OR NOT version STREQUAL OPENRHI_SLANG_VERSION)
        message(FATAL_ERROR "OpenRHI requires Slang ${OPENRHI_SLANG_VERSION}; found '${version}'")
    endif()
    add_executable(OpenRHI::slangc IMPORTED GLOBAL)
    set_target_properties(OpenRHI::slangc PROPERTIES IMPORTED_LOCATION "${compiler}")
    set_property(GLOBAL PROPERTY OPENRHI_SLANG_ROOT "${root}")
endfunction()

function(openrhi_compile_shader)
    cmake_parse_arguments(S "" "NAME;SOURCE;ENTRY;STAGE;TARGET;OUTPUT;HEADER;AIR;TASK_PAYLOAD_SIZE" "DEFINES;INCLUDES" ${ARGN})
    if(NOT S_SOURCE MATCHES "\\.slang$" OR NOT S_NAME)
        message(FATAL_ERROR "openrhi_compile_shader requires NAME and a .slang SOURCE")
    endif()
    openrhi_require_slang()
    get_filename_component(source "${S_SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT S_TARGET)
        if(WIN32)
            set(S_TARGET dxil)
        elseif(APPLE)
            set(S_TARGET metal)
        else()
            set(S_TARGET spirv)
        endif()
    endif()
    if(NOT S_TARGET MATCHES "^(dxil|spirv|metal)$")
        message(FATAL_ERROR "OpenRHI Slang outputs are dxil, spirv, or metal")
    endif()
    if(S_TARGET STREQUAL "metal" AND S_ENTRY STREQUAL "main")
        message(FATAL_ERROR "Metal entry points require a descriptive global name, such as updateParticles; Slang reserves main")
    endif()
    set(base "${CMAKE_CURRENT_BINARY_DIR}/${S_NAME}")
    set(reflection "${base}.reflection.json")
    set(depfile "${base}.d")
    set(args -lang slang -target ${S_TARGET} -O3 -warnings-as-errors all -reflection-json "${reflection}" -depfile "${depfile}")
    if(S_ENTRY)
        list(APPEND args -entry ${S_ENTRY} -stage ${S_STAGE})
    endif()
    foreach(define IN LISTS S_DEFINES)
        list(APPEND args "-D${define}")
    endforeach()
    foreach(path IN LISTS S_INCLUDES)
        list(APPEND args -I "${path}")
    endforeach()
    if(S_TARGET STREQUAL "dxil")
        if(NOT CMAKE_HOST_WIN32)
            message(FATAL_ERROR "The pinned OpenRHI DXIL downstream library requires a Windows host")
        endif()
        if(OPENRHI_SLANG_DXIL_ROOT)
            set(downstream "${OPENRHI_SLANG_DXIL_ROOT}")
        else()
            FetchContent_Declare(openrhi_slang_dxil
                URL "https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2609/dxc_2026_09_29.zip"
                URL_HASH SHA256=ad31b1fc8443175d204f77a611fdb3ef2ec42759bdc2f1167368de24a4a7e7f1
                DOWNLOAD_EXTRACT_TIMESTAMP TRUE SOURCE_SUBDIR unused)
            FetchContent_MakeAvailable(openrhi_slang_dxil)
            set(downstream "${openrhi_slang_dxil_SOURCE_DIR}")
        endif()
        if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "ARM64|arm64|aarch64")
            set(arch arm64)
        else()
            set(arch x64)
        endif()
        if(NOT EXISTS "${downstream}/bin/${arch}/dxcompiler.dll")
            message(FATAL_ERROR "Missing Slang DXIL downstream library: ${downstream}/bin/${arch}/dxcompiler.dll")
        endif()
        list(APPEND args -profile sm_6_6 -dxc-path "${downstream}/bin/${arch}" -DOPENRHI_TARGET_D3D12=1)
        set(binary "${base}.dxil")
    elseif(S_TARGET STREQUAL "spirv")
        list(APPEND args -profile sm_6_6 -capability spirv_1_6 -fvk-use-entrypoint-name -DOPENRHI_TARGET_VULKAN=1)
        if(S_STAGE STREQUAL "mesh" OR S_STAGE STREQUAL "amplification")
            list(APPEND args -capability spvMeshShadingEXT)
        endif()
        set(binary "${base}.spirv")
    else()
        list(APPEND args -capability metallib_4_0 -line-directive-mode none -DOPENRHI_TARGET_METAL=1)
        set(binary "${base}.metal")
    endif()
    add_custom_command(OUTPUT "${binary}" "${reflection}"
        COMMAND OpenRHI::slangc "${source}" ${args} -o "${binary}"
        DEPENDS "${source}" OpenRHI::slangc
        DEPFILE "${depfile}" VERBATIM)
    if(S_TARGET STREQUAL "metal" AND APPLE)
        find_program(xcrun xcrun REQUIRED)
        if(IOS)
            if(CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
                set(sdk iphonesimulator)
                set(minimum -mios-simulator-version-min=26.0)
            else()
                set(sdk iphoneos)
                set(minimum -mios-version-min=26.0)
            endif()
        else()
            set(sdk macosx)
            set(minimum -mmacosx-version-min=26.0)
        endif()
        set(air "${base}.air")
        add_custom_command(OUTPUT "${air}"
            COMMAND "${xcrun}" -sdk ${sdk} metal -std=metal4.0 ${minimum} -c "${binary}" -o "${air}"
            DEPENDS "${binary}" VERBATIM)
        set(binary "${base}.metallib")
        add_custom_command(OUTPUT "${binary}"
            COMMAND "${xcrun}" -sdk ${sdk} metallib "${air}" -o "${binary}"
            DEPENDS "${air}" VERBATIM)
        if(S_AIR)
            set(${S_AIR} "${air}" PARENT_SCOPE)
        endif()
    endif()
    if(S_HEADER)
        if(NOT S_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR NOT S_ENTRY)
            message(FATAL_ERROR "Shader headers require a C identifier NAME and an explicit ENTRY")
        endif()
        if(S_TARGET STREQUAL "metal" AND NOT APPLE)
            message(FATAL_ERROR "Metallib headers require an Apple assembler host; use OUTPUT for cross-target source inspection")
        endif()
        if(NOT DEFINED S_TASK_PAYLOAD_SIZE)
            set(S_TASK_PAYLOAD_SIZE 0)
        endif()
        if(NOT S_TASK_PAYLOAD_SIZE MATCHES "^[0-9]+$")
            message(FATAL_ERROR "TASK_PAYLOAD_SIZE must be the declared payload byte size")
        endif()
        set(header "${base}.h")
        add_custom_command(OUTPUT "${header}"
            COMMAND "${CMAKE_COMMAND}" "-DINPUT=${binary}" "-DOUTPUT=${header}" "-DNAME=${S_NAME}" "-DREFLECTION=${reflection}" "-DENTRY=${S_ENTRY}" "-DTASK_PAYLOAD_SIZE=${S_TASK_PAYLOAD_SIZE}"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/EmbedShader.cmake"
            DEPENDS "${binary}" "${reflection}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/EmbedShader.cmake" VERBATIM)
        set(${S_HEADER} "${header}" PARENT_SCOPE)
    endif()
    if(S_OUTPUT)
        set(${S_OUTPUT} "${binary}" PARENT_SCOPE)
    endif()
endfunction()
