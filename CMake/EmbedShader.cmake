file(READ "${INPUT}" bytes HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
set(text "#pragma once\nalignas(8) static const unsigned char g_${NAME}[] = {${bytes}};\n")
if(ENTRY)
    file(READ "${REFLECTION}" reflection)
    string(JSON count LENGTH "${reflection}" entryPoints)
    math(EXPR last "${count} - 1")
    set(found FALSE)
    foreach(i RANGE ${last})
        string(JSON name GET "${reflection}" entryPoints ${i} name)
        if(name STREQUAL ENTRY)
            set(found TRUE)
            string(JSON stage GET "${reflection}" entryPoints ${i} stage)
            set(dimensions "1, 1, 1")
            if(stage STREQUAL "compute" OR stage STREQUAL "mesh" OR stage STREQUAL "amplification")
                string(JSON x GET "${reflection}" entryPoints ${i} threadGroupSize 0)
                string(JSON y GET "${reflection}" entryPoints ${i} threadGroupSize 1)
                string(JSON z GET "${reflection}" entryPoints ${i} threadGroupSize 2)
                if(x GREATER 65535 OR y GREATER 65535 OR z GREATER 65535 OR x LESS 1 OR y LESS 1 OR z LESS 1)
                    message(FATAL_ERROR "Slang threadgroup dimensions exceed the OpenRHI descriptor range")
                endif()
                set(dimensions "${x}, ${y}, ${z}")
            endif()
            string(APPEND text "static constexpr const char* g_${NAME}_entry = \"${ENTRY}\";\nstatic constexpr uint32_t g_${NAME}_threads[3] = {${dimensions}};\n")
            string(TOUPPER "${stage}" stage_name)
            if(stage STREQUAL "amplification")
                set(stage_name TASK)
            elseif(stage STREQUAL "hull")
                set(stage_name TESS_CONTROL)
            elseif(stage STREQUAL "domain")
                set(stage_name TESS_EVALUATION)
            elseif(stage STREQUAL "raygeneration")
                set(stage_name RAYGEN)
            elseif(stage STREQUAL "closesthit")
                set(stage_name CLOSEST_HIT)
            elseif(stage STREQUAL "anyhit")
                set(stage_name ANY_HIT)
            endif()
            string(APPEND text "static const openrhi::ShaderDesc g_${NAME}_desc = {openrhi::StageBits::${stage_name}_SHADER, g_${NAME}, sizeof(g_${NAME}), g_${NAME}_entry, openrhi::Dim_t(g_${NAME}_threads[0]), openrhi::Dim_t(g_${NAME}_threads[1]), openrhi::Dim_t(g_${NAME}_threads[2]), ${TASK_PAYLOAD_SIZE}};\n")
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Entry '${ENTRY}' missing from Slang reflection")
    endif()
endif()
file(WRITE "${OUTPUT}" "${text}")
