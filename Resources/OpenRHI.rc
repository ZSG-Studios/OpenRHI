        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ZSG Studios"
            VALUE "FileVersion", VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2021 NVIDIA Corporation; OpenRHI modifications (c) 2026 ZSG Studios"
            VALUE "ProductName", "OpenRHI"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif
