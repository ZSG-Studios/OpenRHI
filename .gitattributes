* text=auto
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.h text eol=crlf
*.hpp text eol=crlf
*.cpp text eol=crlf

# Preserve compiler and runtime evidence verbatim.
Logs/XmakeMigration/** -whitespace

# SDK compiler helpers carry byte-level consumer qualification hashes.
Scripts/Build/shader.py -text whitespace=cr-at-eol
Xmake/openrhi_slang.lua -text whitespace=cr-at-eol
Xmake/tasks.lua -text whitespace=cr-at-eol
