# Assemble tokens so this guard can audit its own source.
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
string(CONCAT legacy_api "[Dd][Xx]" "11|[Dd]3[Dd]" "11|[Dd]irect3[Dd]" "[ -]?11")
string(CONCAT translation "[Mm]olten" "[Vv][Kk]|[Pp]ortability_[Ee]numeration|[Pp]ortability_[Ss]ubset|[Mm]etal_[Ss]urface|VK_USE_PLATFORM_" "METAL")
string(CONCAT browser_api "[Ww]eb" "[Gg][Pp][Uu]|[Ww][Gg]" "[Pp][Uu]|[Ww][Gg]" "[Ss][Ll]")
file(GLOB_RECURSE files LIST_DIRECTORIES false
    "${ROOT}/Include/*" "${ROOT}/Source/*" "${ROOT}/Scripts/*"
    "${ROOT}/.github/*" "${ROOT}/.agents/*" "${ROOT}/Tests/*")
list(APPEND files "${ROOT}/CMakeLists.txt" "${ROOT}/README.md" "${ROOT}/AGENTS.md")
foreach(path IN LISTS files)
    file(READ "${path}" content)
    if(path MATCHES "${legacy_api}|${translation}|${browser_api}" OR content MATCHES "${legacy_api}|${translation}|${browser_api}")
        message(FATAL_ERROR "Unsupported backend reference in ${path}")
    endif()
endforeach()
file(GLOB_RECURSE owned
    "${ROOT}/Source/*" "${ROOT}/Include/*" "${ROOT}/Scripts/*" "${ROOT}/CMake/*"
    "${ROOT}/Shaders/*" "${ROOT}/Tests/*" "${ROOT}/Profiles/*" "${ROOT}/Qualification/*"
    "${ROOT}/.github/*" "${ROOT}/.agents/*")
list(APPEND owned "${ROOT}/CMakeLists.txt" "${ROOT}/README.md" "${ROOT}/AGENTS.md"
    "${ROOT}/MIGRATION.md" "${ROOT}/QUALIFICATION.md" "${ROOT}/SHADERS.md" "${ROOT}/openrhi.natvis")
string(CONCAT legacy_name "(^|[^A-Za-z0-9])([Nn][Rr][Ii]"
    "([A-Z_][A-Za-z0-9_]*|[^A-Za-z0-9_]|$)|[Aa]rc[Rr]ender[A-Za-z0-9_]*)")
string(CONCAT wrong_brand "OPEN" "RHI[A-Za-z]")
foreach(path IN LISTS owned)
    file(RELATIVE_PATH relative "${ROOT}" "${path}")
    file(READ "${path}" content)
    if(relative MATCHES "${legacy_name}" OR content MATCHES "${legacy_name}|${wrong_brand}")
        message(FATAL_ERROR "Legacy or incorrectly capitalized owned API name in ${relative}")
    endif()
endforeach()
file(GLOB_RECURSE vulkan "${ROOT}/Source/VK/*")
foreach(path IN LISTS vulkan)
    file(READ "${path}" content)
    if(content MATCHES "WIN32|_WIN32|Win32|vulkan-1.dll")
        message(FATAL_ERROR "Windows native path in Vulkan backend: ${path}")
    endif()
endforeach()
message(STATUS "OpenRHI source boundary passed")

file(GLOB_RECURSE shaders "${ROOT}/Shaders/*" "${ROOT}/Include/*" "${ROOT}/Tests/*")
foreach(path IN LISTS shaders)
    if(path MATCHES "\\.(hlsl|glsl|metal)$")
        message(FATAL_ERROR "Owned shaders must use Slang: ${path}")
    endif()
endforeach()
file(GLOB_RECURSE pipeline "${ROOT}/Source/*" "${ROOT}/CMake/*")
list(APPEND pipeline "${ROOT}/CMakeLists.txt")
string(CONCAT retired_compiler "Shader" "Make|SHADER" "MAKE|metalir" "converter|METAL_SHADER_" "CONVERTER|SMM" "B")
foreach(path IN LISTS pipeline)
    file(READ "${path}" content)
    if(content MATCHES "${retired_compiler}")
        message(FATAL_ERROR "Retired shader pipeline in ${path}")
    endif()
endforeach()
